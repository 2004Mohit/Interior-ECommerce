VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Client environment only ('sandbox' | 'production')
VITE_CASHFREE_MODE=sandbox
VITE_CASHFREE_APP_ID=your_cashfree_app_id_here

# NOTE: The following secrets MUST ONLY be configured in Supabase Edge Function Secrets:
# CASHFREE_APP_ID=your_cashfree_app_id
# CASHFREE_SECRET_KEY=your_cashfree_secret_key
# CASHFREE_API_VERSION=2023-08-01
# CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_signature_key